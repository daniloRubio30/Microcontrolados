{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keil: sincronizar arquivos",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\sync_keil.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Keil: abrir projeto",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "Start-Process -FilePath '${workspaceFolder}\\projeto_micro.uvprojx'"
      ],
      "dependsOn": [
        "Keil: sincronizar arquivos"
      ],
      "problemMatcher": []
    },
    {
      "label": "Keil: monitorar pastas src",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\sync_keil.ps1",
        "-Watch"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    }
  ]
}
